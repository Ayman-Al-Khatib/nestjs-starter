{
  "name": "nestjs-starter",
  "version": "1.0.0",
  "description": "Production-ready NestJS base project — modular architecture with JWT auth, RBAC, i18n, file storage, notifications, rate limiting, and strict conventions.",
  "author": "Ayman Al-Khatib",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=production node dist/main",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "cross-env NODE_ENV=development typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts",
    "typeorm:prod": "cross-env NODE_ENV=production node ./node_modules/typeorm/cli.js -d dist/infrastructure/database/data-source.js",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run:prod": "npm run typeorm:prod -- migration:run",
    "migration:revert:prod": "npm run typeorm:prod -- migration:revert",
    "migration:show:prod": "npm run typeorm:prod -- migration:show",
    "i18n:sync": "ts-node --files src/scripts/i18n/i18n.script.ts",
    "seed:dev": "npm run build && cross-env NODE_ENV=development node dist/scripts/seed/seed.script.js",
    "seed:prod": "cross-env NODE_ENV=production node dist/scripts/seed/seed.script.js"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "magic-bytes.js": "^1.13.0",
    "multer": "^2.1.1",
    "nestjs-i18n": "^10.8.4",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.4.0",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^(core|domain|infrastructure|modules|shared|bootstrap|test-utils)/(.*)$": "<rootDir>/$1/$2"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.interface.ts",
      "!**/*.enum.ts",
      "!**/*.constants.ts",
      "!**/*.constant.ts",
      "!**/*.tokens.ts",
      "!**/*.token.ts",
      "!**/index.ts",
      "!**/main.ts",
      "!**/data-source.ts",
      "!**/*.d.ts",
      "!**/migrations/**",
      "!**/seeders/**",
      "!**/seed-*.ts",
      "!**/scripts/**",
      "!**/test-utils/**",
      "!**/translation-keys.ts",
      "!**/*.dto.ts",
      "!**/*.schema.ts",
      "!**/*.repository.ts",
      "!**/bootstrap/**",
      "!**/app-database.*.ts",
      "!**/health.controller.ts",
      "!**/notifications/**",
      "!**/whatsapp/**",
      "!**/whatsapp-client/**",
      "!**/storage/providers/**",
      "!**/storage/processing/**",
      "!**/storage/http/decorators/**",
      "!**/storage/http/pipes/**",
      "!**/storage/service/**",
      "!**/i18n.service.ts",
      "!**/i18n-validation-error.handler.ts",
      "!**/global-exception.filter.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 92,
        "statements": 92
      }
    }
  }
}
