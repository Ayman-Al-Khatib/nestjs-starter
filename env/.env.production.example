# ============================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# 1. Copy this file to .env.production
# 2. Replace every CHANGE_ME_* value with a real credential
# ============================================================

# --- Server ---
APP_PORT=3000
NODE_ENV="production"
APP_URL="CHANGE_ME_APP_PUBLIC_URL"

# --- Security (CORS / proxy / body) ---
# Comma-separated origin allowlist. NEVER use `*` in production.
CORS_ORIGINS="CHANGE_ME_https://your-app-domain.com,https://admin.your-app-domain.com"
# `trust proxy`: integer = hops behind known proxies; CIDR = specific upstreams.
# `loopback` is safe if you front this with a single reverse proxy on localhost.
TRUST_PROXY="1"
# Hard cap on JSON/urlencoded body size. File uploads use Multer (separate limit).
BODY_LIMIT="1mb"

# --- Rate limiting (global per-IP sliding window) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Strict limit for auth endpoints (login / OTP / refresh).
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# Strict limit for upload endpoints (photos, attachments).
UPLOAD_THROTTLE_TTL_SECONDS=60
UPLOAD_THROTTLE_LIMIT=10

# --- Database (PostgreSQL) ---
DB_HOST="CHANGE_ME_DB_HOST"
DB_PORT=5432
DB_USER="CHANGE_ME_DB_USER"
DB_PASSWORD="CHANGE_ME_DB_PASSWORD"
DB_NAME="CHANGE_ME_DB_NAME"
# TODO(per-project): set the Postgres schema name for this project.
DB_SCHEMA="base_project"

# --- JWT ---
JWT_ACCESS_SECRET="CHANGE_ME_STRONG_32+_CHARS_ACCESS_SECRET"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000
# Bound into every issued token; tokens with mismatched iss/aud are rejected.
JWT_ISSUER="CHANGE_ME_ISSUER_IDENTIFIER"
JWT_AUDIENCE="CHANGE_ME_AUDIENCE_IDENTIFIER"

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Admin seeder ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CHANGE_ME_BEFORE_DEPLOY"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"

# --- Cache (Redis) ---
# noop disables caching entirely. Switch to "redis" to opt in without touching code.
CACHE_DRIVER="noop"
# Required when CACHE_DRIVER=redis. Ignored otherwise.
REDIS_HOST="CHANGE_ME_REDIS_HOST"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# Prepended to every key — lets multiple apps share one Redis safely.
# TODO(per-project): set the Redis key prefix for this project.
REDIS_KEY_PREFIX="base-project"

# --- Storage ---
STORAGE_DRIVER="supabase"
STORAGE_SIGNING_SECRET="CHANGE_ME_STORAGE_SIGNING_SECRET_32PLUS_CHARS!!"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_SUPABASE_URL="CHANGE_ME_SUPABASE_PROJECT_URL"
STORAGE_SUPABASE_SECRET_KEY="CHANGE_ME_SUPABASE_SECRET_KEY"
STORAGE_SUPABASE_BUCKET_PUBLIC="public"
STORAGE_SUPABASE_BUCKET_PRIVATE="private"

# --- Notifications ---
NOTIFICATIONS_FIREBASE_SERVICE_ACCOUNT="CHANGE_ME_FIREBASE_SERVICE_ACCOUNT_JSON"

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_CODE_LENGTH=6
OTP_PHONE_LOCK_WINDOW_SECONDS=14400
OTP_PHONE_MAX_FAILURES_PER_WINDOW=30
OTP_ISSUE_WINDOW_SECONDS=3600
OTP_MAX_ISSUES_PER_WINDOW=3

# --- WhatsApp ---
WHATSAPP_DRIVER=baileys
WHATSAPP_QUEUE_MIN_DELAY_MS=3000
WHATSAPP_QUEUE_MAX_DELAY_MS=8000
WHATSAPP_QUEUE_MAX_SIZE=1000
