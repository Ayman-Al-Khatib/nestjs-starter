# ============================================================
# DEVELOPMENT ENVIRONMENT
# Local-only values. Safe to commit (no real secrets).
# ============================================================

# --- Server ---
APP_PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Security (CORS / proxy / body) ---
# Comma-separated origin allowlist. Use `*` ONLY in development.
CORS_ORIGINS="*"
# Express `trust proxy`: `loopback` | `true` | integer hops | CIDR list.
TRUST_PROXY="loopback"
# Hard cap on request body size (Multer enforces its own limit for uploads).
BODY_LIMIT="1mb"

# --- Rate limiting (global per-IP sliding window) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Strict limit for auth endpoints (login / OTP / refresh). Relaxed in dev
# so tools like Postman / E2E suites don't trip during iteration.
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=50

# Strict limit for upload endpoints (photos). Relaxed in dev for
# repeated upload testing.
UPLOAD_THROTTLE_TTL_SECONDS=60
UPLOAD_THROTTLE_LIMIT=100

# --- Database (PostgreSQL) ---
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="postgres"
# TODO(per-project): set the Postgres schema name for this project.
DB_SCHEMA="nestjs_starter"

# --- JWT ---
JWT_ACCESS_SECRET="dev_access_secret_change_me_32plus_chars!!"
JWT_ACCESS_EXPIRES_IN_SECONDS=86400
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000
# Bound into every issued token; tokens with mismatched iss/aud are rejected.
# TODO(per-project): set the issuer/audience identifiers for this project.
JWT_ISSUER="base-project"
JWT_AUDIENCE="base-project-clients"

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=10

# --- Admin seeder ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"

# --- Cache (Redis) ---
# noop disables caching entirely. Switch to "redis" to opt in without touching code.
CACHE_DRIVER="noop"
# Required when CACHE_DRIVER=redis. Ignored otherwise.
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# TODO(per-project): set the Redis key prefix for this project.
REDIS_KEY_PREFIX="base-project-dev"

# --- Storage ---
STORAGE_DRIVER="local"
STORAGE_SIGNING_SECRET="dev_storage_signing_secret_change_me_32plus!!"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_SUPABASE_URL="https://dummy-project.supabase.co"
STORAGE_SUPABASE_SECRET_KEY="dummy_supabase_secret_key_12345"
STORAGE_SUPABASE_BUCKET_PUBLIC="public"
STORAGE_SUPABASE_BUCKET_PRIVATE="private"

# --- Notifications ---
NOTIFICATIONS_FIREBASE_SERVICE_ACCOUNT="dummy_firebase_service_account_key"

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_CODE_LENGTH=6
OTP_PHONE_LOCK_WINDOW_SECONDS=14400
OTP_PHONE_MAX_FAILURES_PER_WINDOW=30
OTP_ISSUE_WINDOW_SECONDS=3600
OTP_MAX_ISSUES_PER_WINDOW=10
# Dev-only: when set, OTP service persists hash(this code) instead of a random one.
OTP_FIXED_CODE="000000"

# --- WhatsApp ---
WHATSAPP_DRIVER=stub
WHATSAPP_QUEUE_MIN_DELAY_MS=3000
WHATSAPP_QUEUE_MAX_DELAY_MS=8000
WHATSAPP_QUEUE_MAX_SIZE=1000
